{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.invalid/deployments/manifest.schema.json",
  "title": "Pact Arc deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "network",
    "chainId",
    "deploymentTimestamp",
    "deploymentBlock",
    "deployer",
    "gitCommit",
    "usdc",
    "erc8183",
    "pactEvaluator",
    "toolchain",
    "deploymentTransactions",
    "sourceVerification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "DEPLOYED" },
    "network": { "enum": ["arc-testnet", "arc-mainnet"] },
    "chainId": { "enum": ["5042002", "5042"] },
    "deploymentTimestamp": { "type": "string", "format": "date-time" },
    "deploymentBlock": { "$ref": "#/$defs/integerString" },
    "deployer": { "$ref": "#/$defs/address" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "usdc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "decimals"],
      "properties": {
        "address": { "const": "0x3600000000000000000000000000000000000000" },
        "decimals": { "const": 6 }
      }
    },
    "erc8183": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "proxy",
        "implementation",
        "proxyCodeHash",
        "implementationCodeHash",
        "sourceCommit",
        "normativeRevision",
        "defaultAdmin",
        "admin",
        "treasury",
        "platformFeeBps",
        "evaluatorFeeBps",
        "paused",
        "paymentTokenAllowed",
        "hookPolicy"
      ],
      "properties": {
        "classification": { "const": "PACT_MANAGED_PINNED" },
        "proxy": { "$ref": "#/$defs/address" },
        "implementation": { "$ref": "#/$defs/address" },
        "proxyCodeHash": { "$ref": "#/$defs/hash" },
        "implementationCodeHash": { "$ref": "#/$defs/hash" },
        "sourceCommit": { "const": "142e669c1fd318486a4628395b629f033654dd06" },
        "normativeRevision": {
          "const": "a078cab5cc8e9581c15f76c091ed96eed28f02f7"
        },
        "defaultAdmin": { "$ref": "#/$defs/address" },
        "admin": { "$ref": "#/$defs/address" },
        "treasury": { "$ref": "#/$defs/address" },
        "platformFeeBps": { "const": "0" },
        "evaluatorFeeBps": { "const": "0" },
        "paused": { "const": false },
        "paymentTokenAllowed": { "const": true },
        "hookPolicy": { "const": "NONE" }
      }
    },
    "pactEvaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "codeHash",
        "artifactBytecodeHash",
        "commerceContract",
        "verifier",
        "admin",
        "domainVersion"
      ],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "codeHash": { "$ref": "#/$defs/hash" },
        "artifactBytecodeHash": { "$ref": "#/$defs/hash" },
        "commerceContract": { "$ref": "#/$defs/address" },
        "verifier": { "$ref": "#/$defs/address" },
        "admin": { "$ref": "#/$defs/address" },
        "domainVersion": { "const": "2" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solidity",
        "evmTarget",
        "foundryVersion",
        "openZeppelinVersion",
        "viemVersion"
      ],
      "properties": {
        "solidity": { "const": "0.8.28" },
        "evmTarget": { "const": "cancun" },
        "foundryVersion": { "type": "string", "minLength": 1 },
        "openZeppelinVersion": { "const": "5.6.1" },
        "viemVersion": { "const": "2.56.9" }
      }
    },
    "deploymentTransactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "proxy", "allowUsdc", "evaluator"],
      "properties": {
        "implementation": { "$ref": "#/$defs/hash" },
        "proxy": { "$ref": "#/$defs/hash" },
        "allowUsdc": { "$ref": "#/$defs/hash" },
        "evaluator": { "$ref": "#/$defs/hash" }
      }
    },
    "sourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["erc8183Implementation", "erc8183Proxy", "pactEvaluator"],
      "properties": {
        "erc8183Implementation": { "$ref": "#/$defs/verification" },
        "erc8183Proxy": { "$ref": "#/$defs/verification" },
        "pactEvaluator": { "$ref": "#/$defs/verification" }
      }
    },
    "testnetGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "deploymentGitCommit",
        "e2eRuntimeCommit",
        "erc8183SourceCommit",
        "evaluatorCodeHash",
        "completedAt",
        "resultHash",
        "jobId",
        "github",
        "conditionHash",
        "evidenceHash",
        "attestationDigest",
        "settlementTransactionHash",
        "event",
        "runtimeCodeHashes"
      ],
      "properties": {
        "status": { "const": "PASS" },
        "deploymentGitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "e2eRuntimeCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "erc8183SourceCommit": {
          "const": "142e669c1fd318486a4628395b629f033654dd06"
        },
        "evaluatorCodeHash": { "$ref": "#/$defs/hash" },
        "completedAt": { "type": "string", "format": "date-time" },
        "resultHash": { "$ref": "#/$defs/hash" },
        "jobId": { "$ref": "#/$defs/positiveIntegerString" },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "pullRequest",
            "baseBranch",
            "mergeCommitSha"
          ],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "pullRequest": { "type": "integer", "minimum": 1 },
            "baseBranch": { "type": "string", "minLength": 1 },
            "mergeCommitSha": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            }
          }
        },
        "conditionHash": { "$ref": "#/$defs/hash" },
        "evidenceHash": { "$ref": "#/$defs/hash" },
        "attestationDigest": { "$ref": "#/$defs/hash" },
        "settlementTransactionHash": { "$ref": "#/$defs/hash" },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blockNumber", "logIndex"],
          "properties": {
            "blockNumber": { "$ref": "#/$defs/positiveIntegerString" },
            "logIndex": { "type": "integer", "minimum": 0 }
          }
        },
        "runtimeCodeHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "erc8183Proxy",
            "erc8183Implementation",
            "pactEvaluator"
          ],
          "properties": {
            "erc8183Proxy": { "$ref": "#/$defs/hash" },
            "erc8183Implementation": { "$ref": "#/$defs/hash" },
            "pactEvaluator": { "$ref": "#/$defs/hash" }
          }
        }
      }
    },
    "mainnetGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "chainId",
        "mainnetReleaseCommit",
        "testnetCertifiedRuntimeCommit",
        "erc8183SourceCommit",
        "completedAt",
        "contracts",
        "runtimeCodeHashes",
        "roles",
        "deploymentTransactions",
        "jobId",
        "github",
        "conditionHash",
        "evidenceHash",
        "attestationDigest",
        "settlement",
        "broadcastAttemptCount",
        "economics",
        "finalState",
        "resultHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "status": { "const": "PASS" },
        "chainId": { "const": "5042" },
        "mainnetReleaseCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "testnetCertifiedRuntimeCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "erc8183SourceCommit": {
          "const": "142e669c1fd318486a4628395b629f033654dd06"
        },
        "completedAt": { "type": "string", "format": "date-time" },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "proxy", "pactEvaluator"],
          "properties": {
            "implementation": { "$ref": "#/$defs/address" },
            "proxy": { "$ref": "#/$defs/address" },
            "pactEvaluator": { "$ref": "#/$defs/address" }
          }
        },
        "runtimeCodeHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "erc8183Implementation",
            "erc8183Proxy",
            "pactEvaluator"
          ],
          "properties": {
            "erc8183Implementation": { "$ref": "#/$defs/hash" },
            "erc8183Proxy": { "$ref": "#/$defs/hash" },
            "pactEvaluator": { "$ref": "#/$defs/hash" }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "treasury", "provider", "verifier", "relay"],
          "properties": {
            "operator": { "$ref": "#/$defs/address" },
            "treasury": { "$ref": "#/$defs/address" },
            "provider": { "$ref": "#/$defs/address" },
            "verifier": { "$ref": "#/$defs/address" },
            "relay": { "$ref": "#/$defs/address" }
          }
        },
        "deploymentTransactions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "proxy", "allowUsdc", "evaluator"],
          "properties": {
            "implementation": { "$ref": "#/$defs/hash" },
            "proxy": { "$ref": "#/$defs/hash" },
            "allowUsdc": { "$ref": "#/$defs/hash" },
            "evaluator": { "$ref": "#/$defs/hash" }
          }
        },
        "jobId": { "$ref": "#/$defs/positiveIntegerString" },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "pullRequest",
            "baseBranch",
            "mergeCommitSha",
            "mergedAt"
          ],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "pullRequest": { "type": "integer", "minimum": 1 },
            "baseBranch": { "type": "string", "minLength": 1 },
            "mergeCommitSha": { "$ref": "#/$defs/gitCommitSha" },
            "mergedAt": { "type": "string", "format": "date-time" }
          }
        },
        "conditionHash": { "$ref": "#/$defs/hash" },
        "evidenceHash": { "$ref": "#/$defs/hash" },
        "attestationDigest": { "$ref": "#/$defs/hash" },
        "settlement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transactionHash",
            "receiptBlockNumber",
            "receiptBlockHash",
            "pactCompletionAccepted",
            "jobCompleted"
          ],
          "properties": {
            "transactionHash": { "$ref": "#/$defs/hash" },
            "receiptBlockNumber": { "$ref": "#/$defs/positiveIntegerString" },
            "receiptBlockHash": { "$ref": "#/$defs/hash" },
            "pactCompletionAccepted": { "$ref": "#/$defs/eventCoordinate" },
            "jobCompleted": { "$ref": "#/$defs/eventCoordinate" }
          }
        },
        "broadcastAttemptCount": { "const": 1 },
        "economics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "budget",
            "grossFunding",
            "grossProviderPayout",
            "treasuryApplicationPayout",
            "evaluatorApplicationPayout",
            "settledAmount",
            "completionReason"
          ],
          "properties": {
            "budget": { "$ref": "#/$defs/positiveIntegerString" },
            "grossFunding": { "$ref": "#/$defs/positiveIntegerString" },
            "grossProviderPayout": { "$ref": "#/$defs/positiveIntegerString" },
            "treasuryApplicationPayout": { "const": "0" },
            "evaluatorApplicationPayout": { "const": "0" },
            "settledAmount": { "const": "0" },
            "completionReason": { "$ref": "#/$defs/hash" }
          }
        },
        "finalState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobStatus", "bindingAccepted"],
          "properties": {
            "jobStatus": { "const": 3 },
            "bindingAccepted": { "const": true }
          }
        },
        "resultHash": { "$ref": "#/$defs/hash" }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "gitCommitSha": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "integerString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "positiveIntegerString": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "verification": { "enum": ["VERIFIED", "PENDING", "UNAVAILABLE"] },
    "eventCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockNumber", "blockHash", "logIndex"],
      "properties": {
        "blockNumber": { "$ref": "#/$defs/positiveIntegerString" },
        "blockHash": { "$ref": "#/$defs/hash" },
        "logIndex": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
