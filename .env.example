# Documentation only. Copy to a local ignored file and provide verified values.
# Never store real secrets in this file or expose server-only values to browser code.

# Deployment environment: use an explicit allow-listed value in application config.
PACT_ENVIRONMENT=development

# Server-only Phase 4A application and persistence configuration.
PACT_APP_ORIGIN=http://localhost:3000
# At least 32 UTF-8 bytes; protects manual/process/recovery mutation routes.
PACT_INTERNAL_API_TOKEN=
DATABASE_URL=

# Server-only Arc read configuration. No contract address is inferred.
ARC_RPC_URL=
ARC_CHAIN_ID=
ERC8183_COMMERCE_CONTRACT_ADDRESS=
PACT_EVALUATOR_ADDRESS=

# Server-only Pact verifier signing secret. Production must use a managed signer/HSM.
# A raw key is acceptable only for local development and must never use NEXT_PUBLIC_.
PACT_VERIFIER_PRIVATE_KEY=
PACT_ATTESTATION_TTL_SECONDS=300

# Optional server-only GitHub API token for public-repository rate limits.
# Public verification also supports unauthenticated reads. Never use NEXT_PUBLIC_.
GITHUB_TOKEN=

# 16–256 UTF-8 bytes; used only for raw-body HMAC-SHA256 verification.
GITHUB_WEBHOOK_SECRET=
