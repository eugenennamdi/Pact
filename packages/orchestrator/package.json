{
  "name": "@pact/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "deploy:arc": "node dist/deployment/deploy.js",
    "operator:e2e": "node dist/deployment/operator.js",
    "recover:expired-attestation": "node dist/deployment/recover-expired-attestation.js",
    "test:phase5-local": "node dist/deployment/local-e2e.js",
    "test:phase5-staged-local": "node dist/deployment/local-e2e.js",
    "test:e2e": "node dist/relay/e2e.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pact/database": "0.0.0",
    "@pact/protocol": "0.0.0",
    "@pact/verifier": "0.0.0",
    "viem": "2.56.9"
  }
}
