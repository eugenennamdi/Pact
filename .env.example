# Documentation only. Copy to a local ignored file and provide verified values.
# Never store real secrets in this file or expose server-only values to browser code.

# Deployment environment: use an explicit allow-listed value in application config.
PACT_ENVIRONMENT=development

# Server-only Phase 4A application and persistence configuration.
PACT_APP_ORIGIN=http://localhost:3000
# Public product origin used for trusted-Origin and SIWE domain/URI binding.
PACT_PUBLIC_ORIGIN=http://localhost:3000
# Server-only HMAC key for short-lived HttpOnly wallet sessions. Minimum 32 bytes.
# Set a high-entropy value only in an ignored operator environment file.
PACT_SESSION_SECRET=
PACT_PRODUCT_ARC_RPC_URL=https://rpc.testnet.arc.io
# At least 32 UTF-8 bytes; protects manual/process/recovery mutation routes.
PACT_INTERNAL_API_TOKEN=
DATABASE_URL=

# Server-only Arc read configuration. No contract address is inferred.
ARC_RPC_URL=
ARC_CHAIN_ID=
ERC8183_COMMERCE_CONTRACT_ADDRESS=
PACT_EVALUATOR_ADDRESS=

# Server-only Pact verifier signing secret. Production must use a managed signer/HSM.
# A raw key is acceptable only for local development and must never use NEXT_PUBLIC_.
PACT_VERIFIER_PRIVATE_KEY=
PACT_ATTESTATION_TTL_SECONDS=300

# Server-only dedicated transaction relay EOA. It must differ from the verifier
# key and must not be used for unrelated/manual transactions.
PACT_RELAY_PRIVATE_KEY=

# Optional server-only GitHub API token for public-repository rate limits.
# Public verification also supports unauthenticated reads. Never use NEXT_PUBLIC_.
GITHUB_TOKEN=

# 16–256 UTF-8 bytes; used only for raw-body HMAC-SHA256 verification.
GITHUB_WEBHOOK_SECRET=

# Server-only Phase 5 deployment inputs. Keep the journal outside the repository:
# it contains serialized signed transactions used for ambiguity-safe recovery.
PACT_DEPLOY_NETWORK=arc-testnet
PACT_DEPLOY_RPC_URL=
PACT_DEPLOY_CONFIRM=
PACT_DEPLOYER_PRIVATE_KEY=
PACT_ERC8183_DEFAULT_ADMIN=
PACT_ERC8183_ADMIN=
PACT_ERC8183_TREASURY=
PACT_VERIFIER_ADDRESS=
PACT_RELAY_ADDRESS=
PACT_EVALUATOR_ADMIN=
PACT_DEPLOY_JOURNAL_PATH=
PACT_DEPLOY_MANIFEST_PATH=deployments/arc-testnet.json

# Mainnet only. Must point to a reviewed Testnet PASS manifest for the exact release.
PACT_TESTNET_MANIFEST_PATH=deployments/arc-testnet.json
PACT_MAINNET_DEPLOY_APPROVAL=

# Operator-only controlled settlement. State/journal paths must be outside the repo.
# Use `prepare` through Submitted/AWAITING_CONDITION, then reuse the exact same
# state, journal, scope, identities, and condition with `resume`.
PACT_E2E_ACTION=prepare
PACT_E2E_MANIFEST_PATH=deployments/arc-testnet.json
PACT_E2E_RPC_URL=
PACT_E2E_CONFIRM=
PACT_E2E_USDC_BASE_UNITS=100000
PACT_E2E_CLIENT_PRIVATE_KEY=
PACT_E2E_PROVIDER_PRIVATE_KEY=
PACT_E2E_JOURNAL_PATH=
PACT_E2E_STATE_PATH=
# Immutable for the full prepare/resume lifecycle of one controlled job.
PACT_E2E_OPERATION_SCOPE=
PACT_E2E_GITHUB_REPOSITORY=
PACT_E2E_GITHUB_PULL_REQUEST=
PACT_E2E_GITHUB_BASE_BRANCH=main
PACT_MAINNET_E2E_APPROVAL=
